import { useState } from "react";
import { WalletPayment } from "./WalletPayment";

const OPERATORS = [
  {
    id: "orange",
    name: "Orange Money",
  },
  {
    id: "mtn",
    name: "MTN Mobile Money",
  },
  {
    id: "moov",
    name: "Moov Money",
  },
  {
    id: "wave",
    name: "Wave",
  },
];

const QUICK_AMOUNTS = [
  1000,
  2000,
  5000,
  10000,
  20000,
  50000,
];

export function WalletTopUp() {
  const [operator, setOperator] = useState("");
  const [amount, setAmount] = useState<number | null>(null);
  const [customAmount, setCustomAmount] = useState("");
  const [showPayment, setShowPayment] = useState(false);

  const selectedAmount =
    customAmount !== ""
      ? Number(customAmount)
      : amount;

  const isValidAmount =
    Number.isFinite(selectedAmount) &&
    selectedAmount >= 1000;

  const handleQuickAmount = (value: number) => {
    setAmount(value);
    setCustomAmount("");
  };

  const handleCustomAmount = (
    event: React.ChangeEvent<HTMLInputElement>
  ) => {
    const value = event.target.value;

    setCustomAmount(value);
    setAmount(null);
  };

  const handleContinue = () => {
    if (!operator || !isValidAmount) {
      return;
    }

    setShowPayment(true);
  };

  if (showPayment) {
    return (
      <WalletPayment
        operator={operator}
        amount={selectedAmount}
        onBack={() => setShowPayment(false)}
      />
    );
  }

  return (
    <div className="space-y-6">
      <div>
        <h2 className="text-xl font-bold text-white">
          Recharger mon portefeuille
        </h2>

        <p className="text-gray-400 text-sm mt-1">
          Choisis ton opérateur et le montant à ajouter.
        </p>
      </div>

      <div>
        <p className="text-white font-semibold mb-3">
          Choisir un opérateur
        </p>

        <div className="grid grid-cols-2 gap-3">
          {OPERATORS.map((item) => (
            <button
              key={item.id}
              type="button"
              onClick={() => setOperator(item.id)}
              className={`p-4 rounded-xl border text-left transition ${
                operator === item.id
                  ? "border-green-400 bg-green-500/10"
                  : "border-white/10 bg-white/5 hover:bg-white/10"
              }`}
            >
              <p className="text-white font-semibold">
                {item.name}
              </p>
            </button>
          ))}
        </div>
      </div>

      <div>
        <p className="text-white font-semibold mb-3">
          Choisir un montant
        </p>

        <div className="grid grid-cols-2 gap-3">
          {QUICK_AMOUNTS.map((value) => (
            <button
              key={value}
              type="button"
              onClick={() => handleQuickAmount(value)}
              className={`p-4 rounded-xl border transition ${
                amount === value && customAmount === ""
                  ? "border-green-400 bg-green-500/10"
                  : "border-white/10 bg-white/5 hover:bg-white/10"
              }`}
            >
              <span className="text-white font-bold">
                {value.toLocaleString("fr-FR")} XOF
              </span>
            </button>
          ))}
        </div>
      </div>

      <div>
        <label
          htmlFor="customAmount"
          className="text-white font-semibold block mb-3"
        >
          Autre montant
        </label>

        <div className="relative">
          <input
            id="customAmount"
            type="number"
            min="1000"
            step="1"
            value={customAmount}
            onChange={handleCustomAmount}
            placeholder="Exemple : 3500"
            className="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-4 pr-16 text-white outline-none focus:border-green-400"
          />

          <span className="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">
            XOF
          </span>
        </div>

        {customAmount !== "" &&
          Number(customAmount) < 1000 && (
            <p className="text-red-400 text-sm mt-2">
              Le montant minimum est de 1 000 XOF.
            </p>
          )}
      </div>

      <button
        type="button"
        disabled={!operator || !isValidAmount}
        onClick={handleContinue}
        className="w-full rounded-xl bg-green-500 py-4 text-white font-bold disabled:opacity-40 disabled:cursor-not-allowed"
      >
        Continuer vers le paiement
      </button>

      <p className="text-center text-gray-500 text-xs">
        Le paiement Mobile Money sera connecté à l'étape suivante.
      </p>
    </div>
  );
}